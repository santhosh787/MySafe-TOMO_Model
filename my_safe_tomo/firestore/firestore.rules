rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isLinkedGuardian(userId) {
      return signedIn()
        && exists(/databases/$(database)/documents/guardianLinks/$(userId + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/guardianLinks/$(userId + '_' + request.auth.uid)).data.status == 'active';
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'displayName', 'email', 'phoneNumber', 'createdAt', 'updatedAt', 'lastCheckInAt'
        ]);
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'email', 'phoneNumber', 'updatedAt', 'lastCheckInAt'
        ]);
      allow delete: if false;

      match /devices/{deviceId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['token', 'updatedAt', 'platform'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 20;
        allow delete: if isOwner(userId);
      }

      match /incidents/{incidentId} {
        allow read: if isOwner(userId) || isLinkedGuardian(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['type', 'message', 'status', 'createdAt', 'location'])
          && request.resource.data.type == 'sos'
          && request.resource.data.status == 'open'
          && request.resource.data.createdAt == request.time
          && (request.resource.data.location == null
            || (request.resource.data.location is map
              && request.resource.data.location.keys().hasOnly(['latitude', 'longitude', 'accuracyMeters', 'capturedAt'])
              && request.resource.data.location.latitude is number
              && request.resource.data.location.longitude is number));
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt'])
          && request.resource.data.status in ['resolved', 'cancelled'];
        allow delete: if false;
      }
    }

    // Pair links and invite secrets are created/consumed only by trusted Cloud Functions.
    match /guardianLinks/{linkId} {
      allow read: if signedIn()
        && (resource.data.userUid == request.auth.uid || resource.data.guardianUid == request.auth.uid);
      allow write: if false;
    }

    match /guardianInvites/{inviteId} {
      allow read, write: if false;
    }

    match /dispatchLogs/{logId} {
      allow read, write: if false;
    }
  }
}
